{
  "buildCommand": "pnpm install && pnpm --filter @workspace/poke-haven run build",
  "outputDirectory": "artifacts/poke-haven/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_API_HOST/api/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
